user := env("DOCKERHUB_USER", "akhilfolium")
docker := env("DOCKER", if path_exists("/usr/bin/podman") == "true" { "podman" } else { "docker" })

# Build image
build:
    {{docker}} build -t {{user}}/opencode-agent .

# Run locally (needs OPENAI_API_KEY)
run:
    {{docker}} run --rm -p 8000:8000 -e OPENAI_API_KEY {{user}}/opencode-agent

# Run with the exact same writable-/workspace + hardening Nasiko's real deploy
# applies (nasiko upload/deploy --writable) — non-root uid, read-only root,
# 128Mi tmpfs at /workspace. Use this to test the writable-workspace behavior
# itself; plain `just run` already works fine without it (root + writable
# root fs by default), since $HOME just points at a plain writable directory.
# Run with a size-capped tmpfs /workspace, matching --writable in production
run-writable:
    {{docker}} run --rm \
        --read-only --user 65534:65534 --cap-drop=ALL --security-opt=no-new-privileges \
        --tmpfs /workspace:size=128m,mode=1777 \
        -p 8000:8000 -e OPENAI_API_KEY \
        {{user}}/opencode-agent

# Same as run-writable, but bind-mounts a real host directory at /workspace
# instead of an ephemeral tmpfs, so actual file edits persist to disk on the
# host. Usage: `just run-project ~/path/to/project`. Note $HOME is also
# /workspace (see Dockerfile), so opencode's own .cache/.config/.local end up
# alongside your project files — a known, documented tradeoff (DEBUGGING.md).
# Run against a real host directory bind-mounted at /workspace
run-project dir:
    {{docker}} run --rm \
        --user 65534:65534 --cap-drop=ALL --security-opt=no-new-privileges \
        -v {{dir}}:/workspace \
        -p 8000:8000 -e OPENAI_API_KEY \
        {{user}}/opencode-agent

# Push image
push:
    {{docker}} push {{user}}/opencode-agent

# Build + push
release: build push
