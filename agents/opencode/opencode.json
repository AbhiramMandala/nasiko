{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai-chat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI (chat completions)",
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  }
}
