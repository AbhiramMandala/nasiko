# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# The OSS bundle is committed and published to the public repo, so `cargo build`
# there needs no Node toolchain (docs/UI_SYNC.md). The EE bundle stays private
# and is built at release time.
!/oss/dist
!/oss/dist/**
# Build metadata, not part of the served bundle: only scripts/check-budgets.ts
# reads it, and it is regenerated by every build.
/oss/dist/.vite/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# gstack reports (qa, land-and-deploy)
.gstack/qa-reports/
.gstack/deploy-reports/

# MSW writes its worker here on install (package.json `msw.workerDirectory`).
# The served copy is common/public/mockServiceWorker.js, which Vite picks up as
# publicDir; this one is a build-time artifact of the install, not source.
/public/

# env
.env

# live-contract recorder state (plans/feat-live-contract.md §5)
.live/

# Playwright
test-results/
playwright-report/
# Storybook
storybook-static/
