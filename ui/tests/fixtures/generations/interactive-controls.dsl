Sure — building that now.
root = AppStack([headerRow, kpiRow, tableSection], "md")
$days = 7
$query = ""
headerRow = AppRow([title, rangeButtons], "md", "center", "between")
title = AppStack([], "xs")
rangeButtons = AppRow([sevenBtn, thirtyBtn, ninetyBtn], "sm")
sevenBtn = AppButton("7 days", $days == 7 ? "primary" : "secondary", null, null, null, null, null, null, null, null, setDays7)
thirtyBtn = AppButton("30 days", $days == 30 ? "primary" : "secondary", null, null, null, null, null, null, null, null, setDays30)
ninetyBtn = AppButton("90 days", $days == 90 ? "primary" : "secondary", null, null, null, null, null, null, null, null, setDays90)
setDays7 = Action([@Set($days, 7), @Run(summaryQ), @Run(historyQ), @Run(agentRows)])
setDays30 = Action([@Set($days, 30), @Run(summaryQ), @Run(historyQ), @Run(agentRows)])
setDays90 = Action([@Set($days, 90), @Run(summaryQ), @Run(historyQ), @Run(agentRows)])
summaryQ = Query("fetchUsageSummary", [], {request_count: 0, total_cost_usd: 0, avg_latency_ms: 0})
kpiRow = AppRow([costCard, requestCard, latencyCard], "md")
costCard = AppStatCard("Total cost", "$" + @Round(summaryQ.total_cost_usd, 2), null, "neutral")
requestCard = AppStatCard("Requests", summaryQ.request_count, null, "neutral")
latencyCard = AppStatCard("Avg latency", @Round(summaryQ.avg_latency_ms, 0) + " ms", null, "neutral")
tableSection = AppStack([searchBox, table], "md")
searchBox = AppSearch("md", null, false, false, "Search agents...", $query, null, null, null, null, null, runSearch)
runSearch = Action([@Set($query, $event), @Run(agentRows)])
historyQ = Query("fetchUsageHistory", [$days], [])
agentRows = Query("fetchUsageByAgent", [$query, 1, 50], [], "data")
table = AppTable(agentRows, 50, "pages", false)
Here's your cost dashboard with time-window buttons (7/30/90 days), KPI cards for total cost/requests/latency, and a searchable agent usage table — let me know what else you'd like to adjust!