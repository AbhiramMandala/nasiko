root = AppStack([header, kpiRow, chartsGrid, agentTable], "md")
header = AppText("TokenOps Dashboard", "title")
dashboardQ = Query("fetchTokenopsDashboard", [{range: "7d"}], {data: {kpis: {total_spend: {current: 0, previous: 0, change_pct: null}, total_tokens: {current: 0, previous: 0, change_pct: null}, cost_per_operation: {current: 0, previous: 0, change_pct: null}, avg_latency_ms: {current: null, previous: null, change_pct: null}}, summary: {}, attributions: {rows: []}, agents: [], token_usage: {}}}, "data")
kpiRow = AppStatRow([{label: "Total spend", value: dashboardQ.kpis.total_spend.current, delta: dashboardQ.kpis.total_spend.change_pct, trend: dashboardQ.kpis.total_spend.change_pct > 0 ? "up" : dashboardQ.kpis.total_spend.change_pct < 0 ? "down" : "neutral", format: "currency", sub: "Last 7 days"}, {label: "Total tokens", value: dashboardQ.kpis.total_tokens.current, delta: dashboardQ.kpis.total_tokens.change_pct, trend: dashboardQ.kpis.total_tokens.change_pct > 0 ? "up" : dashboardQ.kpis.total_tokens.change_pct < 0 ? "down" : "neutral", format: "tokens", sub: "Last 7 days"}, {label: "Cost per operation", value: dashboardQ.kpis.cost_per_operation.current, delta: dashboardQ.kpis.cost_per_operation.change_pct, trend: dashboardQ.kpis.cost_per_operation.change_pct > 0 ? "up" : dashboardQ.kpis.cost_per_operation.change_pct < 0 ? "down" : "neutral", format: "currency", sub: "Last 7 days"}])
chartsGrid = AppGrid([spendChart, tokenChart, agentBreakdown], 3, "md")
spendTimeseries = Query("fetchSpendTimeseries", [{range: "7d"}], {data: {bucket: "day", points: []}}, "data.points")
spendChart = AppChart({labels: spendTimeseries.bucket_start, datasets: [{label: "Spend (USD)", data: spendTimeseries.spend_usd}]}, "line", false, "currency", "USD", null, null, "auto", "No spend data in the last 7 days")
tokenChart = AppChart({labels: spendTimeseries.bucket_start, datasets: [{label: "Operations", data: spendTimeseries.operations}]}, "line", false, "compact", null, null, null, "auto", "No operations in the last 7 days")
agentBreakdown = AppChart({labels: dashboardQ.agents.agent_name, datasets: [{label: "Cost (USD)", data: dashboardQ.agents.total_cost}]}, "bar", false, "currency", "USD", null, null, "auto", "No agent data available")
agentTable = AppTable(@Sort(dashboardQ.agents, "total_cost", "desc"), 20, "pages", false, null, null, "No agents have recorded usage in the last 7 days")

